# Demo mode uses real Open-Meteo data with a scripted planner (no LLM key).
DEMO_MODE=true

# For a live model, set one provider key and DEMO_MODE=false
# OPENAI_API_KEY=sk-...
# ANTHROPIC_API_KEY=sk-ant-...
# LLM_PROVIDER=openai

API_PORT=8742
DEBUG=false

# Browser calls same-origin /backend; Next proxies to this URL.
API_INTERNAL_URL=http://127.0.0.1:8742
# Optional override if you want the browser to call the API directly:
# NEXT_PUBLIC_API_URL=http://localhost:8742

# Comma-separated origins allowed to call the API directly (not via the Next proxy).
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3847,http://127.0.0.1:3847

# How the web agent talks to the MCP server.
# stdio: spawn `python3 -m mcp_server.server` (same as Cursor / Claude Desktop).
# inprocess: attach the MCP client to the in-memory server (used by pytest).
MCP_TRANSPORT=stdio
